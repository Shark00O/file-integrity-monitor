# Copy to .env and fill in your own values. Never commit a real .env.
# Email alerts are OFF unless all of these are set.
FIM_SMTP_HOST=smtp.gmail.com
FIM_SMTP_PORT=587
FIM_SMTP_USER=you@example.com
FIM_SMTP_PASSWORD=your-app-password-here
FIM_ALERT_EMAIL=you@example.com
# Optional: override where the HMAC key is stored (used by tests).
# FIM_KEY_PATH=
